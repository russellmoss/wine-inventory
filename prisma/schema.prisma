// Bhutan Wine Company — Prisma schema (Prisma 6, Neon Postgres)
// Auth models (User/Session/Account/Verification) are owned by Better Auth
// (generated via its CLI). Domain + audit models follow.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ───────────────────────── Auth (Better Auth) ─────────────────────────

model User {
  id                     String                  @id
  name                   String
  email                  String
  emailVerified          Boolean                 @default(false)
  image                  String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  role                   String?
  banned                 Boolean?                @default(false)
  banReason              String?
  banExpires             DateTime?
  mustChangePassword     Boolean?                @default(false)
  passwordChangedAt      DateTime?
  sessions               Session[]
  accounts               Account[]
  fieldNotes             FieldNote[]
  assistantConversations AssistantConversation[]
  voiceProfiles          VoiceProfile[]
  voicePreferences       VoicePreference[]
  // Phase 5 (D9): vineyard MEMBERSHIP set — replaced the single assignedVineyardId column
  // (dropped in migration 20260629000300 after the backfill was verified).
  vineyardMemberships    UserVineyard[]
  // Phase 12 multi-tenancy (K2): org memberships (user↔org join, multi-org capable) + invites sent.
  memberships            Member[]
  sentInvitations        Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy       String?
  // Multi-tenancy (K2): the tenant the session is currently acting in. Set by the Better Auth
  // organization plugin on login (see auth.ts session hook); re-validated against `member` each
  // request in getCurrentUser (K13). Plain string, no FK — matches the plugin's schema.
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ───────────────────────── Organizations = tenants (Phase 12) ─────────────────────────
// The Organization IS the tenant (K2). These + the auth core (User/Session/Account/Verification)
// stay GLOBAL — no tenantId, no RLS, and on the Prisma-extension DENYLIST (U8) — because Better
// Auth queries them during login, BEFORE a tenant is known. A user is a global identity with
// org memberships. Hand-authored to match the Better Auth organization plugin schema (v1.6.x):
// member = user↔org join (multi-org capable); active org lives on session.activeOrganizationId.

model Organization {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  logo        String?
  metadata    String? // Better Auth stores org metadata as a JSON string here
  createdAt   DateTime     @default(now())
  updatedAt   DateTime?    @updatedAt
  members     Member[]
  invitations Invitation[]

  @@map("organization")
}

model Member {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           String       @default("member") // owner | admin | member (org-level)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId]) // a user is a member of an org at most once
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           String? // invited org role
  status         String       @default("pending") // pending | accepted | rejected | canceled
  expiresAt      DateTime?
  inviterId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inviterId])
  @@map("invitation")
}

// ───────────────────────── Enums ─────────────────────────

enum VesselType {
  BARREL
  TANK
}

enum ItemKind {
  BOTTLED_WINE
  FINISHED_GOOD
}

enum MovementKind {
  RECEIVE
  ADJUST
  TRANSFER
  // Phase 16 (Commerce7 DTC): a settled DTC/club/POS sale depletes finished goods. Added in an
  // ISOLATED ALTER TYPE migration (Windows enum rule) BEFORE any column defaults to it.
  SALE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  PASSWORD_RESET
  PASSWORD_CHANGE
  USER_CREATED
  USER_DELETED
  BOTTLING
  STOCK_MOVEMENT
  FIELD_NOTE_CREATED
  FIELD_INPUT_CREATED
  USER_VINEYARD_ASSIGNED
  BRIX_LOGGED
  HARVEST_ESTIMATED
  HARVEST_PICK_RECORDED
  // Phase 4 sample lifecycle (added in a dedicated ALTER TYPE migration — a new enum
  // VALUE can't be used in the transaction that adds it). Panel/tasting create+void
  // reuse CREATE/DELETE.
  SAMPLE_PULLED
  SAMPLE_SENT
  SAMPLE_ATTACHED
  SAMPLE_CANCELLED
  IMPERSONATE
}

enum FeedbackAutomationMode {
  REPORT_ONLY
  PLAN_MODE
  AGENTIC_FIX
}

enum FeedbackTicketKind {
  BUG_REPORT
  FEATURE_REQUEST
}

enum FeedbackSeverity {
  P0
  P1
  P2
}

enum FeedbackItemStatus {
  NEW
  TRIAGED
  IN_PROGRESS
  RESOLVED
  DISMISSED
}

enum FeedbackAutomationStatus {
  NOT_REQUESTED
  AWAITING_APPROVAL
  QUEUED
  RUNNING
  PLANNED
  PR_OPENED
  FAILED
  SKIPPED
  AWAITING_CLARIFICATION // Plan 079: parked waiting on the reporter's answer to a clarification DM
}

// Plan 079: lifecycle of one clarification round asked of a bug reporter.
enum FeedbackClarificationStatus {
  OPEN
  ANSWERED
  CANCELLED
}

enum FeedbackAttachmentCaptureSource {
  AUTO_SCREENSHOT
  MANUAL_UPLOAD
}

enum FeedbackAutomationSource {
  ASSISTANT_FEEDBACK
  FEEDBACK_TICKET
}

enum FeedbackAutomationKind {
  PLAN
  AGENTIC_FIX
}

// The triaged DISPOSITION — what KIND of problem an item is, assigned by the bug-triage goalie
// from root cause (NOT the reporter's intake kind). Decides which workflow the item belongs in.
// Nullable on the models: an untriaged item has no disposition yet. Mirror of the skill's `type`.
enum FeedbackTriageClass {
  DEFECT // real code bug with a concrete lever → auto-fix (in-fence) / human (out-of-fence)
  MODEL_BEHAVIOR // LLM/assistant adherence miss; prompt/eval mitigation, recurrence expected
  PRODUCT_GAP // missing capability / unmodeled path / design decision → /plan or /office-hours
  NOT_A_BUG // works-as-designed / user-error / permissions / empty-state → dismiss
  UNCLEAR // needs /investigate
}

enum VoiceProfileStatus {
  ACTIVE
  DISABLED
  NEEDS_REENROLL
}

enum VoiceProfileProvider {
  LOCAL_VOICEPRINT
  VENDOR_REF
}

enum VoiceFocusDefaultMode {
  OPEN
  MY_VOICE
  TEAM_SESSION
}

// ───────────────────────── Shared registries ─────────────────────────

model Location {
  tenantId              String                  @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id                    String                  @id @default(cuid())
  name                  String
  isSystem              Boolean                 @default(false) // "Winery" = true
  isActive              Boolean                 @default(true)
  kind                  String? // plan 053 B9: classification (cellar/warehouse/crush_pad/lab/bottling/external/other); validated string, nullable = unclassified
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  bottledInventory      BottledInventory[]
  finishedGoodInventory FinishedGoodInventory[]
  stockMovements        StockMovement[]
  bottlingRuns          BottlingRun[]
  bottledLotStates      BottledLotState[] // Phase 7: en-tirage bottle lots physically stored here

  @@unique([tenantId, name])
  // Plan 080 U13a: composite-tenant-FK target (K11). supply_lot + material_movement reference a Location,
  // which is a cross-tenant-risk FK (Phase-12 checklist step 5) — without this unique those FKs can only be
  // simple `-> location(id)`, which does NOT stop a lot in tenant B pointing at tenant A's location.
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("location")
}

// Berry (skin) color of the fruit — the winemaker's "black or white". NOT the map
// display color; that is `Variety.color` (a hex string) and the two are unrelated.
enum BerryColor {
  BLACK
  WHITE
}

// Vine species grouping. OTHER is the deliberate escape hatch (e.g. rupestris,
// riparia) so the closed set never blocks recording a variety.
enum VineSpecies {
  VINIFERA
  HYBRID
  OTHER
}

// Spray Intelligence S4 — DURABLE canopy architecture. The trellis system is a standing
// property of the block, not a weekly observation (a grower must never re-state it 52×/year).
// S1's leaf-wetness modifier needs it: wetness in a leaf-pulled VSP canopy behaves nothing
// like an unmanaged sprawl. OTHER is the escape hatch so a closed set never blocks recording.
enum TrellisSystem {
  VSP
  HIGH_WIRE_CORDON
  SPRAWL
  GDC
  SCOTT_HENRY
  LYRE
  OTHER
}

// Spray Intelligence S4/D12 — cluster architecture, the botrytis/sour-rot microclimate driver.
// Variety carries the DEFAULT (Pinot Noir tight, Cabernet Sauvignon loose — a static viticultural
// fact we already know); VineyardBlock carries an OVERRIDE for clone/site differences.
// Resolution order lives in src/lib/phenology/canopy-profile.ts: block → variety → unknown.
enum ClusterCompactness {
  LOOSE
  MODERATE
  TIGHT
}

model Variety {
  tenantId        String            @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id              String            @id @default(cuid())
  name            String
  abbreviation    String? // 2–4 uppercase code for lot codes (PN, CS). Nullable→backfilled; Postgres unique allows multiple NULLs.
  isActive        Boolean           @default(true)
  color           String? // canonical per-variety map color (hex), consistent across vineyards
  // Optional REFERENCE/presentation attributes (ticket #308). Descriptive only: they
  // are never part of variety identity (name + abbreviation), never feed a lot code,
  // and are not read by the ledger/cost/compliance paths. All nullable so every
  // pre-existing variety keeps its exact historical shape — NAMING-2 provenance.
  clone           String? // e.g. "Dijon 115", "FPS 04"
  rootstock       String? // e.g. "101-14", "3309C", "own-rooted"
  nursery         String? // source nursery the vine material came from
  berryColor      BerryColor? // black or white — see BerryColor, distinct from `color`
  species         VineSpecies?
  // S4/D12: the DEFAULT cluster compactness for this variety. A per-block override lives on
  // VineyardBlock. NULL = not recorded → resolves to `unknown`, never to a default (rule §3.6).
  clusterCompactness ClusterCompactness?
  createdAt       DateTime          @default(now())
  components      VesselComponent[]
  bottlingSources BottlingSource[]
  vineyardBlocks  VineyardBlock[]

  @@unique([tenantId, name])
  @@unique([tenantId, abbreviation])
  @@index([tenantId])
  @@map("variety")
}

// Plan 093 Unit 8 (custom-crush intake): a first-class GROWER — the party that farmed the fruit. Replaces
// the free-text `VineyardDetail.manager` (kept as legacy; NOT auto-parsed). Strongest un-built both-incumbent
// gap. Distinct from Owner (who OWNS the wine): a grower sells fruit that a client then owns. `isEstate`
// flags the winery's own vineyards. Full AGENTS.md 9-step (tenant_isolation RLS, etc.).
model Grower {
  tenantId    String   @default("") // Phase 12 tenant scope; FK+RLS at DB level (AGENTS.md 9-step)
  id          String   @id @default(cuid())
  name        String // grower / farm name (per-tenant unique)
  company     String? // legal entity, if different from the display name
  contact     String? // LEGACY free-text contact (phone/email/person). Plan 095 backfills this into the
  // structured fields below and stops writing it; kept for provenance, never a new-data target.
  // Plan 095: Vendor-parity contact fields. phone/email/contactName are REQUIRED in the setup UI but stay
  // nullable at the DB so the backfill + non-UI paths (assistant, seed) never hard-error (mirrors Vendor).
  contactName String? // primary contact person
  phone       String? // primary phone
  email       String? // primary email
  address     String?
  // Plan 095: a THIRD-PARTY grower is paid like a vendor, so it links to a Vendor row (auto-created +
  // QBO-synced) via this plain ref — composite FK -> vendor(tenantId,id) in raw SQL (K11), NO Prisma
  // relation (mirrors Vineyard.growerId). NULL for estate growers (isEstate) — you don't pay yourself.
  vendorId    String?
  isEstate    Boolean  @default(false) // the winery's own vineyard (estate fruit), vs a third-party grower
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, name]) // per-tenant unique name
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — vineyard/block growerId references this
  @@index([tenantId])
  @@index([tenantId, vendorId]) // Plan 095: composite FK -> vendor(tenantId,id)
  @@map("grower")
}

// Plan 095: additional contacts attached to a grower (0..N, beyond the grower's own primary contact),
// mirroring VendorContact. Tenant-scoped + RLS-forced (Phase 12). `growerId` is a PLAIN ref pinned by a
// composite (tenantId, growerId) FK in raw SQL (K11) — NO Prisma relation.
model GrowerContact {
  tenantId  String   @default("")
  id        String   @id @default(cuid())
  growerId  String // plain ref → grower.id (composite-tenant FK in raw SQL, K11)
  name      String
  role      String? // e.g. "Vineyard manager", "Owner", "Accounts"
  phone     String?
  mobile    String?
  email     String?
  isPrimary Boolean  @default(false) // at most one primary per grower (enforced in the core)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id]) // composite-tenant-FK target parity + K11
  @@index([tenantId])
  @@index([tenantId, growerId])
  @@map("grower_contact")
}

// ───────────────────────── Vineyard Intelligence P1: planting geometry ─────────────────────────
// Source of the drawn/derived polygon (brief §14).
enum PlantingAreaSource {
  DRAW // user drew it on the map
  IMPORT // imported (e.g. shapefile / GeoJSON)
  DERIVED // migration-by-union from existing block polygons
}

// Review lifecycle for a planting area (brief §2.2 — propose then confirm).
enum PlantingReviewStatus {
  PROPOSED
  CONFIRMED
}

// Which geometry a version row belongs to (one append-only history table covers both).
enum GeometrySubjectType {
  PLANTING_AREA
  BLOCK
}

model Vineyard {
  tenantId           String                 @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id                 String                 @id @default(cuid())
  name               String
  growerId           String? // Plan 093 Unit 8: the grower that farms this vineyard (composite FK -> grower(tenantId,id), raw-SQL K11). NULL = unassigned/legacy.
  abbreviation       String? // 2–4 uppercase code for lot codes (GS, NT). Nullable→backfilled; Postgres unique allows multiple NULLs.
  isActive           Boolean                @default(true)
  plantingMigratedAt DateTime? // VI-P1: set when the vineyard's blocks were migrated into planting areas (all-or-nothing gate). NULL = not migrated.
  ndviAutoAdd        Boolean                @default(false) // VI-P2: DARK per-vineyard flag — cron auto-enqueues the best new clear NDVI scene ONLY when true (rule §2.8, default off)
  weatherAutoRefresh Boolean                @default(false) // VI-P8: DARK per-vineyard flag — cron auto-refreshes the daily weather series ONLY when true (default off, mirrors ndviAutoAdd)
  createdAt          DateTime               @default(now())
  components         VesselComponent[]
  bottlingSources    BottlingSource[]
  detail             VineyardDetail?
  blocks             VineyardBlock[]
  plantingAreas      VineyardPlantingArea[] // VI-P1: continuous planting areas (analysis masks) inside this vineyard
  fieldNotes         FieldNote[]
  brixLogs           BrixLog[]
  harvestRecords     HarvestRecord[]
  // Phase 5.
  lotMemberships     LotVineyard[] // lots whose source set includes this vineyard
  userMemberships    UserVineyard[] // users who manage this vineyard (D9 membership set)

  @@unique([tenantId, name])
  @@unique([tenantId, abbreviation])
  @@unique([tenantId, id])
  @@index([tenantId])
  @@index([tenantId, growerId]) // Plan 093 Unit 8
  @@map("vineyard")
}

// VI-P1 (brief §14 VineyardPlantingArea): the canonical analysis mask — one continuous set of planted
// rows — sitting between Vineyard and VineyardBlock. Blocks are management units INSIDE a planting area.
// Geometry is versioned via VineyardGeometryVersion (append-only); a boundary edit that changes the shape
// (IoU ≤ 0.98) mints a new version and marks dependents stale, never silently rewrites history (brief §2.3).
model VineyardPlantingArea {
  tenantId            String               @default("") // Phase 12 tenant scope; FK+RLS at DB level (AGENTS.md 9-step)
  id                  String               @id @default(cuid())
  vineyardId          String
  name                String // per-(tenant,vineyard) unique display name
  code                String? // optional short token
  sortOrder           Int                  @default(0)
  geometry            Json // canonical GeoJSON Polygon | MultiPolygon (WGS84)
  geometryVersion     Int                  @default(1) // current version (mirrors the open VineyardGeometryVersion row)
  geometryFingerprint String // canonical-form hash (frame-pinned) — staleness key, shared with soil (P4)
  canonicalAnchor     Json // pinned recenter origin {epsg, originX, originY} used to compute the fingerprint
  effectiveFrom       DateTime             @default(now())
  source              PlantingAreaSource
  excludedHoleNote    String? // free-text note about intentional non-vine holes
  reviewStatus        PlantingReviewStatus @default(PROPOSED)
  areaProjectedM2     Decimal?             @db.Decimal(14, 2) // internal cross-check only
  areaGeodesicM2      Decimal?             @db.Decimal(14, 2) // "Boundary footprint" shown to users
  createdBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  vineyard            Vineyard             @relation(fields: [vineyardId], references: [id], onDelete: Cascade)

  @@unique([tenantId, vineyardId, name])
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — vineyard_block.plantingAreaId references this
  @@index([tenantId])
  @@index([tenantId, vineyardId])
  @@map("vineyard_planting_area")
}

// VI-P1: append-only geometry history for planting areas AND blocks. One open row per subject
// (effectiveTo IS NULL, enforced by a partial unique index). A shape change closes the open row and
// appends the next version; the moat is that the OLD geometry stays retrievable (brief §2.3 / runbook §6).
model VineyardGeometryVersion {
  tenantId        String              @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id              String              @id @default(cuid())
  subjectType     GeometrySubjectType
  subjectId       String // planting-area id or block id (both are (tenantId,id)-unique in their tables)
  version         Int
  geometry        Json // the geometry AS OF this version (WGS84)
  fingerprint     String
  canonicalAnchor Json // frame used for this version's fingerprint
  effectiveFrom   DateTime            @default(now())
  effectiveTo     DateTime? // NULL = current/open version
  iouFromPrev     Decimal?            @db.Decimal(6, 5) // IoU vs the previous version (null for v1)
  reason          String?
  createdBy       String?
  createdAt       DateTime            @default(now())

  @@unique([tenantId, subjectType, subjectId, version])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId])
  @@map("vineyard_geometry_version")
}

// ───────────────────────── Vineyard details + blocks ─────────────────────────

// Sparse, optional per-vineyard metadata (1:1 with Vineyard, created lazily).
// Spacing/elevation are stored canonically in METRIC; the UI converts for display.
model VineyardDetail {
  tenantId    String   @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id          String   @id @default(cuid())
  vineyardId  String   @unique
  gpsLat      Decimal? @db.Decimal(9, 6)
  gpsLng      Decimal? @db.Decimal(9, 6)
  elevationM  Decimal? @db.Decimal(8, 2)
  soilType    String?
  manager     String?
  defaultUnit String   @default("imperial") // "imperial" | "metric"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  vineyard    Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("vineyard_detail")
}

// A planted block within a vineyard. All fields optional; nothing required to save.
// Acreage is NOT stored — it is derived from rowSpacing * vineSpacing * vineCount.
model VineyardBlock {
  tenantId            String             @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id                  String             @id @default(cuid())
  vineyardId          String
  growerId            String? // Plan 093 Unit 8: block-level grower override (else inherits the vineyard's). Composite FK -> grower(tenantId,id), raw-SQL K11.
  blockLabel          String? // e.g. "Block 1", "A"
  code                String? // short token for lot codes (e.g. "1", "A"); falls back to a normalized blockLabel
  numRows             Int? // informational (drives optional vines/row readout)
  rowSpacingM         Decimal?           @db.Decimal(10, 4) // canonical metric
  vineSpacingM        Decimal?           @db.Decimal(10, 4) // canonical metric
  varietyId           String?
  clone               String?
  rootstock           String?
  vineCount           Int?
  yearPlanted         Int?
  irrigated           Boolean?
  polygon             Json? // VI-P1: canonical block analysis boundary (GeoJSON Polygon; was "illustrative"). Spacing-based acreage is still the productive-area authority (units.ts).
  plantingAreaId      String? // VI-P1: parent planting area. Composite FK -> planting_area(tenantId,id), raw-SQL K11. NULL until the vineyard is migrated (all-or-nothing).
  geometryVersion     Int                @default(1) // VI-P1: mirrors the open VineyardGeometryVersion row for this block
  geometryFingerprint String? // VI-P1: canonical-form hash of the current polygon (null until first versioned write)
  color               String? // optional per-block polygon color override (hex)
  // S4: durable canopy architecture — the trellis half of "a leaf-pulled VSP canopy" (council S6).
  // The leaf-pulled half is a weekly FieldNote observation; this half never changes week to week.
  trellisSystem       TrellisSystem?
  // S4/D12: per-block OVERRIDE of Variety.clusterCompactness (clone/site differences are real).
  // NULL = fall back to the variety default; both NULL = `unknown`, never a default (rule §3.6).
  clusterCompactness  ClusterCompactness?
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  vineyard            Vineyard           @relation(fields: [vineyardId], references: [id], onDelete: Cascade)
  variety             Variety?           @relation(fields: [varietyId], references: [id], onDelete: SetNull)
  brixLogs            BrixLog[]
  harvestRecords      HarvestRecord[]
  subblocks           VineyardSubblock[]

  @@unique([tenantId, id]) // plan 039: composite-FK target for work_order_task.blockId (Phase-12 rule)
  @@index([vineyardId])
  @@index([varietyId])
  @@index([tenantId])
  @@index([tenantId, growerId]) // Plan 093 Unit 8
  @@index([tenantId, plantingAreaId]) // VI-P1
  @@map("vineyard_block")
}

// A geographic sub-division of a block (e.g. "A"/"B") for differential picks / experiments.
// `code` is the short token that appears in a lot code between BLOCK and VARIETY.
model VineyardSubblock {
  tenantId  String        @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id        String        @id @default(cuid())
  blockId   String
  code      String // short uppercase token for lot codes (e.g. "A")
  label     String? // optional human label
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  block     VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@unique([tenantId, blockId, code])
  @@index([blockId])
  @@index([tenantId])
  @@map("vineyard_subblock")
}

// ───────────────────────── Vineyard Intelligence P2: spatial analysis (NDVI core) ─────────────────────────
// The data half of brief Release 1B. One estate-wide Sentinel-2 scene per date → masked NDVI raster in blob
// → per-block statistics in Postgres, all with full radiometric provenance and behind a cron-driven claim-first
// outbox (ADR 0009 — no worker/queue). Mirrors the AccountingDelivery outbox + IngestedInvoice blob-metadata
// patterns. All five tables follow the AGENTS.md Phase-12 checklist (tenantId + RLS + composite lineage FKs).
// Cross-tenant-risk FKs are RAW-SQL composite (tenantId, refId)→(tenantId, id) — plain String cols, NO Prisma
// @relation (K11, the accounting/ingestion family precedent), so schema stays lean and RLS still enforces.

// The raster's materialization state. The INFLIGHT placeholder is written on the datasetIdentity key BEFORE
// the external fetch (council C1) so a second concurrent claimant backs off instead of double-spending requests.
enum SpatialDatasetStatus {
  INFLIGHT // placeholder claimed; fetch/decode in progress (a second claimant on the same identity backs off)
  READY // raster stored in blob, provenance complete
  FAILED // terminal failure (validation etc.); a retry mints a fresh identity only if the recipe changes
}

// What a SpatialDataset holds. RASTER only in P2; kept as an enum for the P3+ display/derivative story.
enum SpatialDatasetKind {
  RASTER
}

// The spatial index a dataset/metric represents. NDVI only in P2 (other indices are a Later bucket — a new
// value is an isolated ALTER TYPE migration, the Windows enum rule).
enum SpatialMetric {
  NDVI
}

// What kind of analysis a job runs. NDVI_SCENE only in P2.
enum SpatialJobKind {
  NDVI_SCENE
}

// The outbox lifecycle (mirror DeliveryStatus). WITHHELD = a typed non-retryable hold (quota-exhausted until
// the next billing window, selection-miss after top-3 exhausted, low-coverage, mask-breaking).
enum SpatialJobStatus {
  PENDING
  IN_FLIGHT // claimed by a sweep (lease held)
  PROCESSING // fetch/decode/compute underway
  COMPLETED
  FAILED
  WITHHELD
}

// VI-P3 (NDVI display): what a cached SpatialDatasetDerivative holds. DISPLAY_NDVI = the source NDVI WARPED to a
// north-up EPSG:3857 display grid (council fix #1 — a UTM raster on a 3857 basemap is misregistered ~10 m) and
// Int16-quantized for a cheap PNG serve. SMOOTHED_NDVI is RESERVED for the deferred analytical-3×3 follow-on
// (P3 ships appearance-only resampling); a new value would be an isolated ALTER TYPE (the Windows enum rule).
enum SpatialDerivativeKind {
  DISPLAY_NDVI
  SMOOTHED_NDVI
}

// VI-P3: the scope a saved SpatialStyle applies at. SYSTEM = a built-in palette/domain preset (vineyardId NULL);
// VINEYARD = a per-vineyard saved default (vineyardId set). TENANT scope is deferred (Q3). The scope↔vineyardId
// invariant is a DB CHECK ((scope='VINEYARD') = (vineyardId IS NOT NULL)); uniqueness uses two PARTIAL indexes
// (Postgres treats every NULL vineyardId as distinct, so a plain composite unique would NOT dedupe SYSTEM rows).
enum SpatialStyleScope {
  SYSTEM
  VINEYARD
}

// An immutable satellite scene selected for a vineyard "around a date". Provenance-complete: the STAC
// processing baseline (NOT the Process API serviceVersion), the requested-vs-acquired date drift (S2), and
// Copernicus attribution all live here. Keyed on (tenant, vineyard, providerSceneId) — the same scene is
// selected once. `provider`/`collection`/`processingLevel`/`processingBaseline` are provenance strings.
model SpatialScene {
  tenantId            String   @default("") // Phase 12 tenant scope; FK+RLS at DB level (AGENTS.md 9-step)
  id                  String   @id @default(cuid())
  vineyardId          String // composite FK → vineyard(tenantId, id) (raw SQL, K11)
  provider            String // "CDSE" (Copernicus Data Space Ecosystem)
  collection          String // STAC collection, e.g. "sentinel-2-l2a"
  providerSceneId     String // the STAC item id (e.g. S2A_MSIL2A_...)
  requestedDateTarget DateTime // S2: the "around this date" target the user asked for
  acquiredAt          DateTime // S2: the scene's real acquisition datetime (the analysis axis; offset is derived)
  bounds              Json // AOI/scene footprint used (GeoJSON bbox/polygon, WGS84)
  sceneCloudCover     Decimal  @db.Decimal(6, 3) // STAC eo:cloud_cover % (coarse rank, 0–100)
  processingBaseline  String // ESA processing baseline from the CDSE STAC processing:version (runbook §2.13)
  processingLevel     String // e.g. "L2A"
  selectionReason     String // why this scene won (footprint-contained + lowest-cloud, auto-advance rank, etc.)
  attribution         String // Copernicus attribution string (copernicusAttribution(year))
  createdBy           String? // actor userId who selected it (null for cron auto-add)
  createdAt           DateTime @default(now())

  @@unique([tenantId, vineyardId, providerSceneId]) // one immutable scene per (vineyard, provider scene)
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — spatial_dataset.sceneId references this
  @@index([tenantId])
  @@index([tenantId, vineyardId])
  @@map("spatial_scene")
}

// The stored NDVI raster: bytes in @vercel/blob (private, tenant-namespaced, deterministic key from the
// identity), metadata + typed geotransform here (mirrors IngestedInvoice's "bytes in blob, key in Postgres").
// `datasetIdentity` = hash(vineyardId, providerSceneId, recipeHash) where recipeHash = harmonizeValues +
// maskPolicy + resampling + algorithmVersion (council C1). The INFLIGHT placeholder lands on this unique BEFORE
// the fetch; the blob key is derived from the identity (NOT the sha256) so materialization is idempotent.
model SpatialDataset {
  tenantId           String               @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                 String               @id @default(cuid())
  vineyardId         String // composite FK → vineyard(tenantId, id)
  sceneId            String // composite FK → spatial_scene(tenantId, id)
  datasetIdentity    String // hash(vineyardId, providerSceneId, recipeHash) — the up-front idempotency key (C1)
  kind               SpatialDatasetKind   @default(RASTER)
  metric             SpatialMetric        @default(NDVI)
  status             SpatialDatasetStatus @default(INFLIGHT) // INFLIGHT placeholder → READY on store → FAILED terminal
  algorithmVersion   String // the NDVI algorithm version baked into recipeHash (provenance + identity)
  blobUrl            String? // private Vercel Blob URL (null until READY)
  blobKey            String? // deterministic key derived from datasetIdentity (null until READY)
  blobSha256         String? // content hash of the stored raster (audit; null until READY)
  byteSize           Int? // stored raster size in bytes (null until READY)
  crsEpsg            Int? // raster CRS (metric UTM zone)
  // Typed geotransform (NOT loose Json — the clipper depends on it, council S-decision).
  originX            Decimal?             @db.Decimal(14, 4) // grid origin easting (m)
  originY            Decimal?             @db.Decimal(14, 4) // grid origin northing (m)
  pixelSizeM         Decimal?             @db.Decimal(10, 4) // pixel size (m); 10 m native
  gridWidth          Int? // raster width (px)
  gridHeight         Int? // raster height (px)
  axisYSign          Int? // +1 (y-up, lower-left origin) or -1 (y-down); PixelGrid rebuild depends on it
  // Radiometric provenance (runbook §2.13 — the pinned contract, recorded, never re-derived).
  harmonizeValues    Boolean              @default(false) // MUST be false (harmonize fabricates NDVI=1.0)
  sclResampling      String? // "NEAREST" (20 m SCL → 10 m grid)
  maskDilation       Int                  @default(0) // S3: SCL halo honesty — 0 = no dilation
  processingUnits    Decimal?             @db.Decimal(12, 4) // CDSE PU billed for the fetch
  processingBaseline String? // ESA baseline snapshot (also on the scene; carried for a self-contained provenance)
  attribution        String? // Copernicus attribution
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([tenantId, datasetIdentity]) // C1: up-front idempotency — the INFLIGHT placeholder claims this
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — block_spatial_metric.datasetId references this
  @@index([tenantId])
  @@index([tenantId, vineyardId])
  @@index([tenantId, sceneId])
  @@map("spatial_dataset")
}

// The cron-driven claim-first outbox row (mirror AccountingDelivery). One job per (tenant, idempotencyKey).
// `sceneId`/`datasetId` are lifecycle pointers filled as the job progresses (soft refs, no hard FK — the
// outbox precedent). `withheldReason`/`faultClass` are typed-in-code String unions (mirror
// AccountingDelivery.withheldReason String) so a new reason never needs an ALTER TYPE.
model SpatialAnalysisJob {
  tenantId          String           @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                String           @id @default(cuid())
  vineyardId        String // composite FK → vineyard(tenantId, id)
  kind              SpatialJobKind   @default(NDVI_SCENE)
  status            SpatialJobStatus @default(PENDING)
  idempotencyKey    String // per-tenant idempotent (e.g. ndvi:${vineyardId}:${providerSceneId}:${recipeHash})
  sceneId           String? // set once the scene is selected/created (soft ref)
  datasetId         String? // set once the dataset is materialized (soft ref)
  params            Json // the top-3 ranked candidates + requestedDateTarget + AOI (the auto-advance payload, C4)
  attemptCount      Int              @default(0)
  claimedAt         DateTime?
  leaseExpiresAt    DateTime? // set > 300 s + slack (CDSE took 135 s live; no heartbeat infra) so a long fetch isn't reclaimed
  withheldReason    String? // typed union: "quota-exhausted" | "selection-miss" | "low-coverage" | "mask-breaking" | "no-candidates"
  faultClass        String? // typed union from classifyFault: "quota" | "rate_limit" | "validation" | "transient"
  lastError         String?
  processingVersion String? // the STAC/Process processing version observed
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([tenantId, idempotencyKey]) // idempotent enqueue
  @@index([tenantId])
  @@index([tenantId, status]) // the sweep claims by status
  @@index([tenantId, vineyardId])
  @@map("spatial_analysis_job")
}

// An IMMUTABLE per-block statistics snapshot (council Q1). Permanently bound to the geometryVersion it was
// computed against — geometryVersion is IN the uniqueness key so a v3 and a v4 reading coexist and history is
// never overwritten. A boundary edit ANNOTATES via geometry-version.markStaleFor, never hides/invalidates
// these rows. Below the 0.5 valid floor (council Q3) the summary stats are null + qualityFlags carries
// INSUFFICIENT_VALID_COVERAGE (counts + coverage still recorded — never a biased partial-coverage mean).
model BlockSpatialMetric {
  tenantId               String        @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                     String        @id @default(cuid())
  blockId                String // composite FK → vineyard_block(tenantId, id)
  datasetId              String // composite FK → spatial_dataset(tenantId, id)
  vineyardId             String // denormalized for per-vineyard reads (plain indexed column, no FK — avoids a redundant cascade path)
  metric                 SpatialMetric @default(NDVI)
  acquiredAt             DateTime // copied from the dataset's scene (the analysis axis)
  // ZonalStats (P0) — Decimal, NULLABLE (null below the valid floor).
  min                    Decimal?      @db.Decimal(8, 5)
  p10                    Decimal?      @db.Decimal(8, 5)
  p25                    Decimal?      @db.Decimal(8, 5)
  median                 Decimal?      @db.Decimal(8, 5)
  mean                   Decimal?      @db.Decimal(8, 5)
  p75                    Decimal?      @db.Decimal(8, 5)
  p90                    Decimal?      @db.Decimal(8, 5)
  max                    Decimal?      @db.Decimal(8, 5)
  stdDev                 Decimal?      @db.Decimal(8, 5)
  intersectingPixelCount Int // pixels whose footprint intersects the block
  validPixelCount        Int // intersecting pixels that survived the SCL mask
  effectivePixelCount    Decimal       @db.Decimal(14, 4) // S4: Σcoverage weights — the weighted-mean denominator
  validFraction          Decimal       @db.Decimal(7, 6) // validPixelCount / intersectingPixelCount, [0,1]
  coveredAreaM2          Decimal       @db.Decimal(16, 2) // Σcoverage × pixelArea
  mixedPixelShare        Decimal       @db.Decimal(7, 6) // share of partial-coverage (edge) pixels, [0,1]
  qualityFlags           Json // e.g. ["INSUFFICIENT_VALID_COVERAGE"]
  processingVersion      String? // provenance passthrough
  geometryVersion        Int // Q1: the block geometry version these stats were computed against (IN the unique key)
  geometryFingerprint    String // Q1: the canonical-form fingerprint of that geometry
  createdAt              DateTime      @default(now())

  @@unique([tenantId, blockId, datasetId, metric, geometryVersion]) // Q1/C2: versions coexist, history never overwritten
  @@index([tenantId])
  @@index([tenantId, blockId])
  @@index([tenantId, datasetId])
  @@index([tenantId, vineyardId, metric]) // read the latest metric for a vineyard
  @@map("block_spatial_metric")
}

// Per-tenant/month CDSE quota + blob-egress telemetry (mirror WeighTagCounter's one-row-per-key shape).
// Counts BILLABLE PROVIDER ATTEMPTS, not successful datasets (S6) — a failed fetch still spends a request/PU.
// Drives the visible quota counter + the DARK auto-add headroom gate (rule §2.8). Atomic upsert increments.
model CdseUsageCounter {
  tenantId        String   @default("") // Phase 12 tenant scope; FK+RLS at DB level
  yearMonth       String // "YYYY-MM" (the tenant's billing bucket)
  requestCount    Int      @default(0) // billable provider requests (success or fail)
  processingUnits Decimal  @default(0) @db.Decimal(14, 4) // CDSE PU consumed
  blobEgressBytes BigInt   @default(0) // raster bytes read out of blob
  updatedAt       DateTime @updatedAt

  @@id([tenantId, yearMonth]) // one row per tenant per month
  @@index([tenantId])
  @@map("cdse_usage_counter")
}

// ───────────────────────── Vineyard Intelligence P4: soil documentation (NRCS SSURGO) ─────────────────────────
// Brief Release 1C. One server-side SDA clip pull per reviewed US block polygon → a dated, sourced,
// per-map-unit soil snapshot. Cards-first (NO map components). SDA is public/keyless — no env secret; the
// only wiring is the outbound host allowlist. Follows the AGENTS.md Phase-12 checklist like the P2 tables:
// tenantId + RLS + composite (tenantId, blockId)→vineyard_block(tenantId, id) FK (K11 raw-SQL, no @relation).
//
// SUPERSEDE-NOT-DELETE: exactly one CURRENT row per block (partial unique on supersededAt IS NULL, declared
// in the migration — Prisma can't express a partial index), superseded rows retained (correction-as-event;
// a sourced soil claim can end up on a label). A boundary edit does NOT delete — the UI compares the block's
// current fingerprint to `polygonFingerprint` and shows a stale badge; a re-pull supersedes.
//
// NO BLENDED PROPERTIES (the whole point): `components` is one entry per map unit with each property cited to
// its mukey at NRCS's published level; area % is the only value we aggregate. `coverageState`/`class` are
// String unions, not enums (Windows enum-ordering trap; dodges an ALTER TYPE serialization vs the P8 lane).
model BlockSoilSnapshot {
  tenantId           String    @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                 String    @id @default(cuid())
  blockId            String // composite FK → vineyard_block(tenantId, id) (raw-SQL K11)
  vineyardId         String // denormalized for per-vineyard reads (plain indexed column, no FK — mirrors block_spatial_metric)
  pulledAt           DateTime  @default(now())
  supersededAt       DateTime? // null = the one CURRENT snapshot; set = retained history
  surveyAreaSymbol   String? // NRCS sacatalog areasymbol(s) covering the block (may be null pre-resolve)
  surveyAreaVersion  String? // sacatalog.saverest — SSURGO is revised annually; a filed claim must be reproducible
  polygonFingerprint String // frame-stable canonical fingerprint (geometry-meta) — staleness signal + cache key
  geometryVersion    Int // the block geometryVersion this snapshot was computed against
  coveredPct         Decimal   @db.Decimal(9, 6) // Σ(clipped area)/block area; may exceed 1 (over-coverage anomaly)
  coverageState      String // "covered" | "partial" | "over" | "none" (String union, not an enum)
  blockAreaSqM       Decimal   @db.Decimal(16, 2) // geodesic block area (local), the display denominator [council C3]
  components         Json // validated-on-read array; one entry per map unit (mukey + class + share + cited properties)
  displayGeometry    Json? // OPTIONAL block-clipped display geometry (FeatureCollection, per-mukey) for the map overlay — NOT authoritative (design §13.6); null until a pull returns renderable geometry
  processingVersion  String // query/algorithm version for provenance
  attribution        String? // NRCS attribution string
  createdBy          String?
  createdAt          DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, blockId]) // read the current + history for a block
  @@index([tenantId, vineyardId]) // per-vineyard soil overview (sums block areas; never blends properties)
  @@map("block_soil_snapshot")
}

// ───────────────────────── VI-P8: Weather & Climate spine (Release 4A) ─────────────────────────

// The AUTHORITATIVE daily climate series (council R1): ONE row per (tenant, vineyard, localDate, providerKey) —
// a raw per-provider daily observation, metrics wide. There is NO mutable snapshot / CURRENT-SUPERSEDED
// machine; rows are UPSERTED on the unique key (recent days PROVISIONAL→FINAL as gridMET/CFSv2 finalize), so
// there is no supersede race. `localDate` is the canonical vineyard-LOCAL civil day normalized AT INGEST
// (council R2 obs-time shift — Tmax→date−1 for AM-obs stations, grids UTC/midnight converted); it is NEVER a
// raw provider date. Every row is strictly SINGLE-PROVIDER — `providerKey` IS the source (no metricSource
// column). Gap-fill + spread are computed ON READ from these pure rows (council confirmatory gate): there is
// deliberately NO filledFromProvider column. Numeric-sanity CHECKs (tminC≤tmaxC, RH 0..100, precip≥0) in the migration.
model VineyardClimateDaily {
  tenantId    String   @default("") // Phase 12 tenant scope; FK+RLS at DB level (AGENTS.md 9-step)
  id          String   @id @default(cuid())
  vineyardId  String // composite FK → vineyard(tenantId, id) (raw SQL, K11)
  providerKey String // the SINGLE source of this row: "gridmet" | "daymet" | "nasa_power" | "rcc_acis" | "noaa_cdo"
  localDate   DateTime @db.Date // canonical vineyard-local civil day (obs-time normalized at ingest, R2)
  tmaxC       Decimal? @db.Decimal(6, 3) // daily max temp °C (nullable — a provider may not carry a metric)
  tminC       Decimal? @db.Decimal(6, 3) // daily min temp °C
  precipMm    Decimal? @db.Decimal(8, 3) // daily precipitation mm
  rhMaxPct    Decimal? @db.Decimal(6, 3) // daily max relative humidity % (grids only; stored for 4B disease inputs)
  rhMinPct    Decimal? @db.Decimal(6, 3) // daily min relative humidity %
  dataStatus  String   @default("PROVISIONAL") // String union (no enum): "PROVISIONAL" | "FINAL"
  provenance  Json // { fetchedAt, sourceUrl, obsConvention, sourceDate, units, resolutionM, attribution }
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tenantId, vineyardId, localDate, providerKey]) // R1: the upsert identity; no CURRENT flag → no supersede race
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11)
  @@index([tenantId])
  @@index([tenantId, vineyardId, localDate]) // the real read path (a vineyard's series over a window)
  @@map("vineyard_climate_daily")
}

// Replaces the mutable snapshot (council R1): EXACTLY ONE row per vineyard (1:1), so the "one current config"
// invariant is STRUCTURAL — no partial index, no status flag. Holds the resolved primary provider + the
// grower override (effectivePrimary = primaryProviderOverride ?? primaryProviderKey, R14 — one shared helper
// so ingest and every read agree), the chosen reference station + station-vs-site elevation delta that
// explains the gap, and the coverage state (US_HIGH_RES via gridMET/Daymet | GLOBAL_COARSE via NASA POWER for
// non-US like Bhutan | UNAVAILABLE — never a blank). Attribution + last-refresh for the offline-rendered card.
model VineyardWeatherConfig {
  tenantId                String    @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                      String    @id @default(cuid())
  vineyardId              String // composite FK → vineyard(tenantId, id); 1:1 per vineyard
  primaryProviderKey      String // resolved default primary (nearest quality station, else grid)
  primaryProviderOverride String? // grower's explicit choice; effectivePrimary = override ?? primaryProviderKey (R14)
  stationOverrideId       String? // grower-chosen ACIS station sid (map pick); when set, ingest uses THIS station, not the auto-nearest
  stationId               String? // active reference station id (RCC-ACIS / NOAA) — the override if chosen, else the auto-nearest
  stationName             String?
  stationDistanceM        Decimal?  @db.Decimal(12, 2) // station→site distance (m)
  stationElevationDeltaM  Decimal?  @db.Decimal(10, 2) // station elevation − site elevation (m); explains any gap
  siteElevationM          Decimal?  @db.Decimal(10, 2) // vineyard site elevation (USGS EPQS)
  coverageState           String    @default("UNAVAILABLE") // String union: "US_HIGH_RES" | "GLOBAL_COARSE" | "UNAVAILABLE"
  attribution             String? // combined provider attribution for the card
  lastRefreshAt           DateTime? // last successful ingest
  timeZone                String? // IANA zone, provider-reported (NWS points.timeZone / Open-Meteo timezone=auto); null = not yet resolved. Site-local "today" chain: this → AppSettings.timeZone → UTC (site-time-core)
  unitSystem              String    @default("METRIC") // String union: "METRIC" | "IMPERIAL" (like coverageState — NOT a Prisma enum). Display-edge only; storage stays metric. Default IMPERIAL for US-forecast-coverage sites (us-coverage helper, NOT the CONUS-only coverageState — council S2)
  lastHistoryTopUpAt      DateTime? // last monthly 3-yr full-year history top-up (sweep; council S3 — keeps the 13–24-month rainfall window from decaying)
  nwsGridId               String? // NWS /points grid cache (plan 096 U11) — the mapping never changes for a fixed coordinate
  nwsGridX                Int?
  nwsGridY                Int?
  // Plan 096 U19 — per-vineyard alert thresholds (metric-stored; 36/32/28/95/100 °F equivalents).
  // Defaults ONLY — no editing UI (user decision 2026-07-26); display converts via units-core.
  frostWatchC             Decimal   @default(2) @db.Decimal(6, 3) // radiational cooling routinely undershoots the forecast min
  frostWarnC              Decimal   @default(0) @db.Decimal(6, 3) // damage to green tissue begins
  hardFreezeC             Decimal   @default(-2) @db.Decimal(6, 3) // severe shoot loss
  heatWatchC              Decimal   @default(35) @db.Decimal(6, 3) // photosynthesis shutdown (the 95 °F ask)
  extremeHeatC            Decimal   @default(38) @db.Decimal(6, 3) // sunburn / raisining on exposed fruit
  // Plan 096 U22 (council C4) — the persisted NWS active-alerts banner: bounded array of
  // {event, headline, severity, endsAt, url}, rendered verbatim between 6-hourly refreshes.
  activeAlertsJson        Json?
  activeAlertsFetchedAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([tenantId, vineyardId]) // 1:1 per vineyard — the structural "one current" invariant
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11)
  @@index([tenantId])
  @@map("vineyard_weather_config")
}

// Per-tenant/DAY per-provider request counter (council R1/Codex#4): the enforcement key is DAILY (`dayKey
// @db.Date`) because NOAA CDO's cap is 10k/DAY (5 req/s) — a monthly key would mis-enforce it. Counts BILLABLE
// provider attempts (success or fail). Drives the sweep's headroom gate. Atomic upsert increments (usage-core).
model WeatherProviderUsage {
  tenantId     String   @default("") // Phase 12 tenant scope; FK+RLS at DB level
  dayKey       DateTime @db.Date // the daily billing bucket (UTC civil day) — the CDO daily-cap enforcement key
  provider     String // "gridmet" | "daymet" | "nasa_power" | "rcc_acis" | "noaa_cdo" | "usgs_epqs"
  requestCount Int      @default(0) // billable provider requests that day (success or fail)
  lastError    String?
  updatedAt    DateTime @updatedAt

  @@id([tenantId, dayKey, provider]) // one row per tenant per day per provider (the daily enforcement key)
  @@index([tenantId])
  @@map("weather_provider_usage")
}

// Plan 096 Phase 2 (U11) — the 7-day forecast, per-provider per-target-day. REPLACED, never
// accumulated: ingest deletes the forward horizon for a (vineyard, provider) then bulk-inserts
// (council C1 — a shortened horizon can't strand a stale future row); the natural key is the
// upsert identity and `issuedAt` is a COLUMN (staleness label), not part of the key. All five
// value columns are NULLABLE end-to-end (council C7 — an evening NWS fetch's day-1 has a low and
// no high; that's a first-class row, never a zero). Never-blend: one row per provider; display/
// alerts/assistant all consume ONE primary series via selectPrimaryForecastSeries. Past
// targetDates are pruned by the daily sweep (no unbounded growth); forecast-vs-actual accuracy
// history is a deliberate LATER (needs its own append-only table).
model VineyardForecastDaily {
  tenantId             String   @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                   String   @id @default(cuid())
  vineyardId           String // composite FK → vineyard(tenantId, id)
  providerKey          String // "nws" | "open_meteo" (String union — no enum)
  targetDate           DateTime @db.Date // vineyard-local civil day this row forecasts
  issuedAt             DateTime // when the provider issued/we fetched this forecast (staleness label)
  tmaxC                Decimal? @db.Decimal(6, 3)
  tminC                Decimal? @db.Decimal(6, 3)
  precipMm             Decimal? @db.Decimal(8, 3)
  precipProbabilityPct Decimal? @db.Decimal(6, 3)
  conditionCode        String   @default("UNKNOWN") // ConditionCode union (condition-core)
  windMaxKph           Decimal? @db.Decimal(7, 2)
  provenance           Json
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([tenantId, vineyardId, providerKey, targetDate]) // the replace-upsert identity
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11)
  @@index([tenantId])
  @@index([tenantId, vineyardId, targetDate]) // the read path (strip + alerts + assistant)
  @@map("vineyard_forecast_daily")
}

// Plan 097 (U3) — hourly forecast slots for the day-detail modal. One row per (provider,
// hourStartUtc); REPLACED like the daily table (delete forward horizon then insert, same ingest
// tx — C1). localDate/localHour are computed AT INGEST from the vineyard tz and never re-derived
// at read. precipDurationH carries the NATIVE amount interval (1 = per-hour Open-Meteo; 3/6 = an
// NWS raw-gridpoint QPF bucket starting at this hour) — the chart draws bars at that width (S6:
// no invented uniform rain). Value columns nullable (C7 — NWS precip-only bucket rows have null
// temps). Volume ≈ 13 vineyards × ≤168 h × ≤2 providers ≈ 4.4k rows fleet-wide, pruned daily.
model VineyardForecastHourly {
  tenantId        String   @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id              String   @id @default(cuid())
  vineyardId      String // composite FK → vineyard(tenantId, id)
  providerKey     String // "nws" | "open_meteo" (String union — no enum)
  hourStartUtc    DateTime // the slot's UTC instant — the replace identity
  localDate       DateTime @db.Date // vineyard-local civil day (modal slicing key)
  localHour       Int // 0–23 in the vineyard tz
  tempC           Decimal? @db.Decimal(6, 3)
  popPct          Decimal? @db.Decimal(6, 3)
  precipMm        Decimal? @db.Decimal(8, 3)
  precipDurationH Int      @default(1) // native amount-interval width in hours
  conditionCode   String   @default("UNKNOWN")
  windKph         Decimal? @db.Decimal(7, 2)
  issuedAt        DateTime // staleness label, mirrors the daily table
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([tenantId, vineyardId, providerKey, hourStartUtc]) // the replace identity
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11)
  @@index([tenantId])
  @@index([tenantId, vineyardId, localDate]) // the modal's day-slice read
  @@map("vineyard_forecast_hourly")
}

// Plan 096 Phase 3 (U19) — the escalation-dedup state that makes "notify once, escalate once,
// never repeat on the 6-hourly cron" survive restarts AND concurrency. The claim is a single
// conditional upsert (INSERT … ON CONFLICT DO UPDATE … WHERE "notifiedRank" < EXCLUDED."notifiedRank"
// RETURNING) — only the tx that WON the rank advance emits notifications (council C2; cron × on-view
// refresh race → one send). `notifiedRank` is the INTEGER tier order the SQL claim compares;
// `notifiedTier` is the display name. De-escalation (council C6): a WARNING+ key dropping below
// watch claims `clearedAt` the same way and emits ONE all-clear; a later re-crossing escalates
// fresh from rank 0 (no flapping). alertType families: FROST | HEAT | SUSTAINED_HEAT (identity =
// first day of the run, Codex DQ1).
model VineyardWeatherAlertState {
  tenantId       String    @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id             String    @id @default(cuid())
  vineyardId     String // composite FK → vineyard(tenantId, id)
  targetDate     DateTime  @db.Date // the forecast night/day this alert is about (card date)
  alertType      String // "FROST" | "HEAT" | "SUSTAINED_HEAT" (String union)
  notifiedTier   String? // display tier last notified ("FROST_WATCH" … "HARD_FREEZE"); null = none/cleared
  notifiedRank   Int       @default(0) // the claim comparator (0 none; family-relative order)
  lastNotifiedAt DateTime?
  clearedAt      DateTime? // set by the all-clear claim; reset on re-escalation
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, vineyardId, targetDate, alertType]) // the dedup identity
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11)
  @@index([tenantId])
  @@map("vineyard_weather_alert_state")
}

// ───────────────────────── Vineyard Intelligence P3: NDVI display (viz half of Release 1B) ─────────────────────────
// Two NEW tenant-scoped tables (AGENTS.md Phase-12 checklist). Additive only. The pure render math (color/render/
// smooth/overlay) already shipped in P2 — P3 adds the DISPLAY caching + saved styles + a serving route + browser wiring.

// A cached, versioned DERIVATIVE of a SpatialDataset raster (council fix #3 — a first-class table, NOT a pointer
// column: one column can't carry display+smoothed+versions). DISPLAY_NDVI = source NDVI warped to a north-up
// EPSG:3857 grid (fix #1) and Int16-quantized (×`quantScale`, `-32768` = no-data — NaN doesn't fit Int16; the SOURCE
// Float32 stays authoritative, fix #6). Blob-stored (mirror SpatialDataset). `recipeVersion` is IN the unique key +
// the serving-route ETag/cache key (fix #7 — never bare `immutable`). Idempotent claim-first materialization (P2 C1).
model SpatialDatasetDerivative {
  tenantId       String                @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id             String                @id @default(cuid())
  datasetId      String // composite FK → spatial_dataset(tenantId, id)
  vineyardId     String // denormalized for per-vineyard reads (plain indexed column, no FK)
  kind           SpatialDerivativeKind @default(DISPLAY_NDVI)
  recipeVersion  Int // bump when the warp/quantize recipe changes (IN the unique key + the serve ETag)
  status         SpatialDatasetStatus  @default(INFLIGHT) // INFLIGHT placeholder → READY on store → FAILED terminal
  blobUrl        String? // private Vercel Blob URL (null until READY)
  blobKey        String? // deterministic key derived from (datasetId, kind, recipeVersion)
  blobSha256     String? // content hash of the stored derivative (audit; null until READY)
  byteSize       Int? // stored derivative size in bytes (null until READY)
  // Warped display geotransform (EPSG:3857, north-up: axisYSign = -1, origin = NW corner).
  crsEpsg        Int? // 3857 (web-mercator display grid)
  originX        Decimal?              @db.Decimal(14, 4) // 3857 easting of the NW corner (m)
  originY        Decimal?              @db.Decimal(14, 4) // 3857 northing of the NW corner (m)
  pixelSizeM     Decimal?              @db.Decimal(10, 4) // 3857 pixel size (m)
  gridWidth      Int? // warped raster width (px)
  gridHeight     Int? // warped raster height (px)
  axisYSign      Int? // -1 (north-up, y-down) for the display grid
  // WGS84 bbox for Leaflet imageOverlay bounds ([minLon, minLat, maxLon, maxLat]) — exact once warped north-up.
  wgs84Bbox      Json? // [minLon, minLat, maxLon, maxLat]
  quantScale     Int                   @default(10000) // Int16 quantization: stored = round(ndvi × quantScale)
  noDataSentinel Int                   @default(-32768) // the Int16 no-data value (NaN doesn't fit Int16)
  recipeHash     String? // hash(warp recipe + quantScale) — provenance
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([tenantId, datasetId, kind, recipeVersion]) // one cached derivative per (dataset, kind, recipe)
  @@index([tenantId])
  @@index([tenantId, datasetId])
  @@index([tenantId, vineyardId])
  @@map("spatial_dataset_derivative")
}

// A saved NDVI color STYLE (palette + domain mode + custom stops). SYSTEM presets (vineyardId NULL) + per-VINEYARD
// saved defaults (Q3; TENANT scope deferred). One-off styles ride URL params and are NEVER persisted here.
// council fix #2: SYSTEM uniqueness needs a PARTIAL unique index (WHERE vineyardId IS NULL) because Postgres treats
// every NULL as distinct; the scope↔vineyardId invariant is a DB CHECK. Both live in the hand-written migration
// (Prisma's schema DSL can't express partial indexes or CHECK), so they are documented but not @@unique here.
model SpatialStyle {
  tenantId       String            @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id             String            @id @default(cuid())
  scope          SpatialStyleScope @default(SYSTEM)
  vineyardId     String? // NULL for SYSTEM; set for VINEYARD (composite FK → vineyard(tenantId, id); DB CHECK ties it to scope)
  metric         SpatialMetric     @default(NDVI)
  name           String // human label; unique per (tenant, scope-bucket, metric) via the partial indexes
  mode           String // ColorScaleMode union (String, not enum — mirrors withheldReason/faultClass typed-in-code unions)
  paletteId      String // "vigor-classic" | "purple-green" | "color-vision-safe"
  reverse        Boolean           @default(false)
  customStops    Json? // CUSTOM mode: [{ value, color: [r,g,b] }] (null otherwise)
  percentileLow  Decimal?          @db.Decimal(4, 3) // relative-mode low percentile (e.g. 0.050); null for fixed modes
  percentileHigh Decimal?          @db.Decimal(4, 3) // relative-mode high percentile (e.g. 0.950)
  fixedMin       Decimal?          @db.Decimal(6, 4) // ABSOLUTE/CUSTOM domain min (null otherwise)
  fixedMax       Decimal?          @db.Decimal(6, 4) // ABSOLUTE/CUSTOM domain max (null otherwise)
  createdBy      String? // actor userId (null for seeded SYSTEM presets)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  // NOTE: uniqueness + the scope↔vineyardId invariant are enforced by TWO partial unique indexes
  // (spatial_style_system_key WHERE vineyardId IS NULL; spatial_style_vineyard_key WHERE vineyardId IS NOT NULL)
  // + a CHECK ((scope = 'VINEYARD') = (vineyardId IS NOT NULL)) in the migration (council fix #2).
  @@index([tenantId])
  @@index([tenantId, scope])
  @@index([tenantId, vineyardId])
  @@map("spatial_style")
}

// ───────────────────────── Vineyard operations: field notes ─────────────────────────

// One canonical weekly field report per vineyard (Friday-anchored). JSON columns
// hold the LLM-friendly weather / inputs / per-block status payloads; vineyard +
// manager stay real FKs for querying. `userEmail` snapshots provenance (mirror
// BottlingRun) so deleting the manager (SetNull) never erases who logged it.
model FieldNote {
  tenantId           String    @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id                 String    @id @default(cuid())
  vineyardId         String
  userId             String? // manager who logged it; SetNull so user delete doesn't cascade
  userEmail          String // durable provenance snapshot
  weekOf             DateTime  @db.Date // Friday anchor, written via the canonical UTC helper
  weatherData        Json // { rainfallMm, maxTempC, minTempC }
  spraysApplied      Json // [{ name, scope: "WHOLE"|"BLOCKS", blockIds: [] }]
  fertilizersApplied Json // same shape as spraysApplied
  blockLevelStatuses Json // { [blockId]: BlockStatus }
  schemaVersion      Int       @default(1) // JSON shape version
  generalNotes       String?
  aiSummary          String?
  aiSummaryStatus    String    @default("PENDING") // PENDING | READY | FAILED
  aiSummaryAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  vineyard           Vineyard  @relation(fields: [vineyardId], references: [id], onDelete: Cascade)
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([tenantId, vineyardId, weekOf]) // one canonical note per vineyard per week
  @@index([vineyardId, weekOf])
  @@index([tenantId])
  @@map("field_note")
}

// Master list of sprays/fertilizers. `normalizedKey` (strip-all-non-alphanumeric
// UPPERCASE) dedupes "NEEM OIL" / "NEEM-OIL" to one row; `name` keeps the label.
model FieldInput {
  tenantId      String   @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id            String   @id @default(cuid())
  type          String // SPRAY | FERTILIZER
  name          String // display, cleaned UPPERCASE
  normalizedKey String // dedup key, strip-all-non-alphanumeric UPPERCASE
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  @@unique([tenantId, type, normalizedKey])
  @@index([tenantId])
  @@map("field_input")
}

// ───────────────────────── Vineyard operations: harvest ledger ─────────────────────────

// Per-block Brix readings logged repeatedly across the ripening window.
// `vineyardId` denormalized for clean aggregates; block delete is Restricted so
// ripening history is never erased by a block edit. DB CHECK enforces 0..40.
model BrixLog {
  tenantId       String        @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id             String        @id @default(cuid())
  blockId        String
  vineyardId     String // denormalized FK for aggregates
  brixValue      Decimal       @db.Decimal(4, 1)
  recordedAt     DateTime      @default(now())
  createdById    String?
  createdByEmail String // provenance snapshot
  note           String?
  block          VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  vineyard       Vineyard      @relation(fields: [vineyardId], references: [id], onDelete: Restrict)

  @@index([blockId, recordedAt])
  @@index([vineyardId])
  @@index([tenantId])
  @@map("brix_log")
}

// One record per (block, vintage): holds the pre-harvest estimate and parents the
// pick passes. `totalWeightKg` is NOT stored — it is the sum of `picks`.
model HarvestRecord {
  tenantId        String        @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id              String        @id @default(cuid())
  blockId         String
  vineyardId      String // denormalized FK for aggregates
  vintageYear     Int
  yieldEstimateKg Decimal?      @db.Decimal(12, 3) // pre-harvest estimate, canonical kg
  createdById     String?
  createdByEmail  String
  updatedByEmail  String?
  note            String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  block           VineyardBlock @relation(fields: [blockId], references: [id], onDelete: Restrict)
  vineyard        Vineyard      @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  picks           HarvestPick[]

  @@unique([tenantId, blockId, vintageYear])
  @@index([vineyardId, vintageYear])
  @@index([tenantId])
  @@map("harvest_record")
}

// Each pick pass against a HarvestRecord. Vineyards pick a block in multiple
// passes; the total auto-rolls up from these rows.
model HarvestPick {
  tenantId        String             @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id              String             @id @default(cuid())
  harvestRecordId String
  pickDate        DateTime           @db.Date
  weightKg        Decimal            @db.Decimal(12, 3) // canonical kg
  brixAtPick      Decimal?           @db.Decimal(4, 1) // optional Brix the fruit came off at
  phAtPick        Decimal?           @db.Decimal(4, 2) // optional field pH (analyte registry: 2.5–4.5)
  taAtPick        Decimal?           @db.Decimal(4, 1) // optional field titratable acidity, g/L tartaric (registry: 0–20)
  createdById     String?
  createdByEmail  String
  note            String?
  weighTagLineId  String? // Plan 093 Unit 9: the weigh-tag bin-line this pick came off (its owner/grower/block source). Composite FK -> weigh_tag_line(tenantId,id), onDelete Restrict (K11, raw-SQL).
  sold            Boolean            @default(false) // Plan 093 Unit 10: fruit sold OUT (not crushed here) → TTB Part IV fruit removal
  createdAt       DateTime           @default(now())
  harvestRecord   HarvestRecord      @relation(fields: [harvestRecordId], references: [id], onDelete: Cascade)
  // Phase 6: lots this pick was (partially) crushed into. A pick can feed several fermenters;
  // Σ consumedKg ≤ weightKg is enforced in the crush tx (no DB unique on harvestPickId).
  crushSources    LotHarvestSource[]

  @@unique([tenantId, id])
  @@index([harvestRecordId, pickDate])
  @@index([tenantId])
  @@index([tenantId, weighTagLineId]) // Plan 093 Unit 9
  @@map("harvest_pick")
}

// Plan 093 Unit 9 (custom-crush intake): weigh-tags. A weigh-tag is a per-TRUCK scale ticket
// (gross/tare/net), NOT per-pick — one flatbed carries many bins from multiple growers for multiple
// owners. The tag number is a gap-free, per-tenant, monotonic certificate; a tag is VOIDED, never deleted.
// Owner/grower/block attach at the LINE (bin) level.

// The per-tenant gap-free tag-number allocator (council: a counter row + SELECT ... FOR UPDATE, NOT
// MAX(tagNumber)+1 which bounces/gaps under SERIALIZABLE + PgBouncer). One row per tenant.
model WeighTagCounter {
  tenantId   String @id // one row per tenant (the tenant IS the key)
  nextNumber Int    @default(1)

  @@map("weigh_tag_counter")
}

model WeighTag {
  tenantId     String         @default("") // Phase 12 tenant scope; FK+RLS at DB level (AGENTS.md 9-step)
  id           String         @id @default(cuid())
  tagNumber    Int // per-tenant monotonic, gap-free certificate number (allocated via WeighTagCounter)
  issuedAt     DateTime       @default(now())
  weighmaster  String? // who weighed it in
  truck        String? // truck / hauler identifier
  grossKg      Decimal?       @db.Decimal(12, 3)
  tareKg       Decimal?       @db.Decimal(12, 3)
  netKg        Decimal?       @db.Decimal(12, 3)
  voidedAt     DateTime? // void-not-delete (mirror LotTreatment); a voided tag stays visible + numbered
  voidedReason String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  lines        WeighTagLine[]

  @@unique([tenantId, tagNumber]) // per-tenant unique certificate number
  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — weigh_tag_line references this
  @@index([tenantId])
  @@map("weigh_tag")
}

model WeighTagLine {
  tenantId             String   @default("") // Phase 12 tenant scope; FK+RLS at DB level
  id                   String   @id @default(cuid())
  weighTagId           String // composite (tenantId, weighTagId) -> weigh_tag(tenantId, id), raw-SQL K11
  binOrGroup           String? // the bin / group label on the ticket
  growerId             String? // the grower that farmed this bin (composite FK -> grower)
  ownerId              String? // the owner of this bin's fruit (composite FK -> owner); NULL + needsOwnerAssignment=false = Estate
  blockId              String? // the vineyard block (composite FK -> vineyard_block)
  netKg                Decimal? @db.Decimal(12, 3)
  // Plan 093 Unit 9: receive-now-assign-later. A NULL ownerId is AMBIGUOUS (estate vs unkeyed); this flag
  // disambiguates — true = unresolved (must be assigned before a pick from it can carry ownership to a
  // lot; crush refuses it, Unit 10). The scale never blocks on a missing owner.
  needsOwnerAssignment Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  weighTag             WeighTag @relation(fields: [weighTagId], references: [id], onDelete: Cascade)

  @@unique([tenantId, id]) // composite cross-tenant FK target (K11) — harvest_pick.weighTagLineId references this
  @@index([tenantId])
  @@index([tenantId, weighTagId])
  @@index([tenantId, ownerId])
  @@index([tenantId, growerId])
  @@map("weigh_tag_line")
}

// ───────────────────────── Bulk / in-process wine ─────────────────────────

model Vessel {
  tenantId         String              @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id               String              @id @default(cuid())
  code             String // barrels: "Barrel #"; tanks: code. Unique per type (see @@unique below).
  type             VesselType
  capacityL        Decimal             @db.Decimal(10, 2)
  isActive         Boolean             @default(true)
  blendName        String? // optional label for the current blend in this vessel
  // Barrel-only metadata (null for tanks). Volume = capacityL (not duplicated here).
  // The barrel's "Barrel #" is its `code` above — no separate number column.
  oakOrigin        String? // e.g. French, American, Hungarian
  cooperageYear    Int? // year the barrel was made
  cooperage        String? // barrel maker, e.g. Seguin Moreau
  toastLevel       String? // e.g. Light, Medium, Medium+, Heavy
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  components       VesselComponent[]
  bottlingSources  BottlingSource[]
  transfersOut     VesselTransfer[]    @relation("VesselTransfersOut")
  transfersIn      VesselTransfer[]    @relation("VesselTransfersIn")
  // Lot + ledger spine (Phase 1): the projection rows, group memberships, and the
  // operation lines that reference this vessel. Additive; existing relations unchanged.
  vesselLots       VesselLot[]
  groupMemberships VesselGroupMember[]
  operationLines   LotOperationLine[]
  treatments       LotTreatment[]
  // Phase 4 standalone records (snapshot context; vessel delete SetNulls these).
  analysisPanels   AnalysisPanel[]
  tastingNotes     LotTastingNote[]
  samples          Sample[]
  // Phase 6: ferment-state transitions captured in this vessel (snapshot context).
  stateEvents      LotStateEvent[]
  // Phase 8b (Unit 8): the 1:1 depreciating-asset sidecar (barrels only; null for tanks).
  barrelAsset      BarrelAsset?

  @@unique([tenantId, type, code]) // barrel "1" and tank "1" can coexist; numbers unique within a type
  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("vessel")
}

model VesselComponent {
  tenantId   String   @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id         String   @id @default(cuid())
  vesselId   String
  varietyId  String
  vineyardId String
  vintage    Int
  volumeL    Decimal  @db.Decimal(10, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  vessel     Vessel   @relation(fields: [vesselId], references: [id], onDelete: Cascade)
  variety    Variety  @relation(fields: [varietyId], references: [id], onDelete: Restrict)
  vineyard   Vineyard @relation(fields: [vineyardId], references: [id], onDelete: Restrict)

  @@unique([tenantId, vesselId, varietyId, vineyardId, vintage])
  @@index([vesselId])
  @@index([varietyId])
  @@index([tenantId])
  @@map("vessel_component")
}

// One racking / wine transfer between two vessels. `volumeL` is the volume drawn
// OUT of the source; `lossL` is what was lost to lees (volume INTO the destination
// = volumeL - lossL). `components` is a JSON snapshot of the moved breakdown
// ([{ varietyName, vineyardName, vintage, volumeL }]) so history reads correctly
// even for multi-lot (tank) racks and survives later vessel edits. Vessel codes
// are snapshotted so a deleted vessel (FK SetNull) still shows in history.
model VesselTransfer {
  tenantId       String           @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  id             String           @id @default(cuid())
  fromVesselId   String?
  toVesselId     String?
  fromVesselCode String
  toVesselCode   String
  volumeL        Decimal          @db.Decimal(10, 2)
  lossL          Decimal          @default(0) @db.Decimal(10, 2)
  components     Json
  note           String?
  actorUserId    String?
  actorEmail     String
  rackedAt       DateTime         @default(now())
  // Revert tracking (LEGACY undo path). Phase 1 (D6/D15) replaces row-reversion with
  // a CORRECTION ledger op; "reverted" is derived from a correction's existence. These
  // columns remain for the pre-cutover history read and are dropped in a later cleanup.
  revertedAt     DateTime?
  revertsId      String?
  reverts        VesselTransfer?  @relation("TransferReversal", fields: [revertsId], references: [id], onDelete: SetNull)
  reversedBy     VesselTransfer[] @relation("TransferReversal")
  fromVessel     Vessel?          @relation("VesselTransfersOut", fields: [fromVesselId], references: [id], onDelete: SetNull)
  toVessel       Vessel?          @relation("VesselTransfersIn", fields: [toVesselId], references: [id], onDelete: SetNull)
  // Phase 1: a RACK is a derived read-model of one ledger operation. Unique 1:1 link;
  // written only by the ledger writer.
  lotOperationId Int?             @unique
  lotOperation   LotOperation?    @relation(fields: [lotOperationId], references: [id], onDelete: SetNull)

  @@index([fromVesselId, rackedAt])
  @@index([toVesselId, rackedAt])
  @@index([rackedAt])
  @@index([revertsId])
  @@index([tenantId])
  @@map("vessel_transfer")
}

// ───────────────────────── Bottling ─────────────────────────

model WineSku {
  tenantId         String                 @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  ownerId          String? // Plan 093 Unit 2: owner-scope; nullable (Estate=NULL); maintained per Unit 4; composite FK -> owner(tenantId,id) in the migration (K11)
  id               String                 @id @default(cuid())
  name             String
  // Phase 7 (K11): NULLABLE for NV / multi-vintage sparkling; isNonVintage marks a true NV
  // SKU (no lying sentinel). Because Postgres treats NULLs as distinct, the old compound
  // @@unique breaks for NV — replaced with TWO partial unique indexes added by hand in the
  // Unit 2 migration: UNIQUE(name,vintage,bottleSizeMl) WHERE vintage IS NOT NULL, and
  // UNIQUE(name,bottleSizeMl) WHERE isNonVintage. Finalize uses find-or-create, not upsert.
  vintage          Int?
  isNonVintage     Boolean                @default(false)
  bottleSizeMl     Int                    @default(750)
  // Phase 7: sparkling metadata on the catalog SKU (batch facts like disgorgedAt / actual
  // dosage g/L live on BottlingRun, not here — council CRITICAL #5).
  method           SparklingMethod?
  dosageStyle      DosageStyle?
  // Plan 080 U7: list PRICE. Safe as a mutable SKU column — it is what you SELL for, not what it COST.
  // COGS deliberately does NOT live here (council C4: a mutable cost column is a second source of truth
  // with no history); purchased cost lives in FinishedGoodReceipt, bottled cost in BottlingCostSnapshot.
  msrp             Decimal?               @db.Decimal(18, 2)
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  categoryId       String?
  category         FinishedGoodCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  bottlingRuns     BottlingRun[]
  bottledInventory BottledInventory[]
  stockMovements   StockMovement[]
  costSnapshots    BottlingCostSnapshot[] // Phase 8: frozen per-SKU COGS snapshots

  @@unique([tenantId, id]) // Phase 8: composite-tenant-FK target for bottling_cost_snapshot (K11)
  @@index([categoryId])
  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@map("wine_sku")
}

model BottlingRun {
  tenantId              String                 @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  ownerId               String? // Plan 093 Unit 2: owner-scope; nullable (Estate=NULL); maintained per Unit 4; composite FK -> owner(tenantId,id) in the migration (K11)
  id                    String                 @id @default(cuid())
  date                  DateTime
  wineSkuId             String
  bottlesProduced       Int
  volumeConsumedL       Decimal                @db.Decimal(10, 2)
  destinationLocationId String
  createdById           String? // soft-deleted users; snapshot below survives
  createdByEmail        String
  createdAt             DateTime               @default(now())
  // Phase 7: sparkling BATCH facts belong on the run, not the catalog SKU (council CRITICAL
  // #5). One BottlingRun per finalize; multiple disgorgement tranches → multiple runs / SKU.
  disgorgedAt           DateTime?
  dosageGramsPerL       Decimal?               @db.Decimal(6, 2)
  // Phase 14 (Fork 1A): the ABV stamped at bottling — required for still wine (validated at the
  // action), resolved at FINISH for sparkling (base ABV + tirage bump). Nullable in the DB so
  // historical runs backfill; the tax-ABV resolver reads it as the as-of-bottling authority.
  bottledAbv            Decimal?               @db.Decimal(5, 2)
  wineSku               WineSku                @relation(fields: [wineSkuId], references: [id], onDelete: Restrict)
  destinationLocation   Location               @relation(fields: [destinationLocationId], references: [id], onDelete: Restrict)
  sources               BottlingSource[]
  stockMovements        StockMovement[]
  costSnapshots         BottlingCostSnapshot[] // Phase 8: frozen per-run+line COGS snapshots

  @@unique([tenantId, id]) // Phase 8: composite-tenant-FK target for bottling_cost_snapshot (K11)
  @@index([wineSkuId])
  @@index([date])
  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@map("bottling_run")
}

model BottlingSource {
  tenantId        String      @default("") // Phase 12 tenant scope (nullable U2 -> backfill U3 -> NOT NULL U5); FK+RLS at DB level
  ownerId         String? // Plan 093 Unit 2: owner-scope; nullable (Estate=NULL); maintained per Unit 4; composite FK -> owner(tenantId,id) in the migration (K11)
  id              String      @id @default(cuid())
  bottlingRunId   String
  // Phase 7 (K13, extended): origin columns are NULLABLE. A blended / multi-vintage sparkling
  // (or blended still-wine) lot has NO single variety/vineyard/vessel origin — the honest
  // provenance is `lotId` (required for lot-sourced runs) + the lineage DAG. Historically
  // `applyBottling` wrote `?? ""`, which inserts an invalid FK and would blow up finalize
  // against Restrict — a latent bug this fixes. `vesselId` is nullable too: a finalized bottle
  // lot has no vessel. Still-wine bottling always sets all three, so no behavior change there.
  vesselId        String?
  varietyId       String?
  vineyardId      String?
  vintage         Int?
  volumeConsumedL Decimal     @db.Decimal(10, 2)
  lotId           String?
  bottlingRun     BottlingRun @relation(fields: [bottlingRunId], references: [id], onDelete: Cascade)
  vessel          Vessel?     @relation(fields: [vesselId], references: [id], onDelete: Restrict)
  variety         Variety?    @relation(fields: [varietyId], references: [id], onDelete: Restrict)
  vineyard        Vineyard?   @relation(fields: [vineyardId], references: [id], onDelete: Restrict)
  lot             Lot?        @relation(fields: [lotId], references: [id], onDelete: SetNull)

  @@index([bottlingRunId])
  @@index([vesselId])
  @@index([lotId])
  @@index([tenantId])
  @@index([tenantId, ownerId])
  @@map("bottling_source")
}

